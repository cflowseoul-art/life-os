{
  "name": "life-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Life OS — AI-based personal and household operating system",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev": "bash scripts/dev.sh",
    "start": "tsx src/main.ts",
    "desk": "tsx core/desk-api.ts",
    "db:schema": "bash scripts/db-schema.sh",
    "db:seed": "bash scripts/db-seed.sh",
    "build": "npm ci --prefix frontend --include=dev && npm run build --prefix frontend",
    "serve": "node --import tsx core/desk-api.ts",
    "start:web": "npm run build && npm run serve",
    "db:lifeos": "bash -c 'psql \"$DATABASE_URL\" -f database/lifeos.sql'",
    "db:migrate": "tsx core/infrastructure/db/migrate.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.13.1",
    "zod": "^4.4.3",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
