# Copy to .env once a PostgreSQL instance is available (see compose.yml).
# Matches the compose.yml service (host port 5433).
DATABASE_URL=postgres://lifeos:lifeos@localhost:5433/lifeos

# Individual variables (used if a tool prefers discrete PG* vars):
PGHOST=localhost
PGPORT=5433
PGUSER=lifeos
PGPASSWORD=lifeos
PGDATABASE=lifeos

# Gemini LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Deployment ─────────────────────────────────────────────────────────────
# Storage adapter: "file" for local development, "postgres" when deployed.
LIFE_OS_STORAGE=file
# Hosted PostgreSQL supplies DATABASE_URL; PGSSL=require for managed providers.
PGSSL=

# Session signing key — 32 characters or more, fixed per deployment.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Google Sign-In. Both hold the same client id: the backend verifies the token's
# audience, and the frontend needs it at build time.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Who may sign in. Comma-separated, server-side only, never sent to the browser.
# An empty list refuses every sign-in — there is no public registration.
ALLOWED_GOOGLE_EMAILS=

# Runtime. The host supplies PORT; HOST=0.0.0.0 to accept external traffic.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
