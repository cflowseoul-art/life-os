import type {
  LlmClient,
} from "../../application/llm-client.js";


type GeminiResponse = {
  candidates?: Array<{
    content?: {
      parts?: Array<{
        text?: string;
      }>;
    };
  }>;
};

export class GeminiLlmClient
  implements LlmClient
{
  constructor(
    private readonly apiKey: string,
    private readonly model: string,
  ) {}

  async generate(
    prompt: string,
  ): Promise<string> {
    const url =
      `https://generativelanguage.googleapis.com/v1beta/models/${this.model}:generateContent?key=${this.apiKey}`;

    const response =
      await fetch(
        url,
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            contents: [
              {
                parts: [
                  {
                    text:
                      this.buildPrompt(prompt),
                  },
                ],
              },
            ],
          }),
        },
      );

    if (!response.ok) {
      const errorBody =
        await response.text();

      throw new Error(
        `Gemini API error: ${response.status}\n${errorBody}`,
      );
    }

    const data =
      await response.json() as GeminiResponse;

    const text =
      data.candidates?.[0]
        ?.content?.parts?.[0]
        ?.text;

    if (!text) {
      throw new Error(
        "Gemini returned empty response",
      );
    }

    return text;
  }

  private buildPrompt(
    prompt: string,
  ): string {
    return `
Convert the user's inventory statement or command into JSON.

Rules:
- Return JSON only.
- Do not include markdown.
- Do not resolve products.
- Do not convert units.

Intent meanings:

purchase_inventory:
- User acquired new inventory.
Examples:
"계란 한 판 샀어"
"우유 2개 사왔어"

consume_inventory:
- User performed an action that consumed inventory.
Examples:
"계란 2개 먹었어"
"우유 마셨어"
"계란 다 먹었어"

adjust_inventory:
- User reports or corrects the current inventory state.
- The user is describing what the inventory currently is, not an action they performed.
Examples:
"계란 0개로 수정해줘"
"냉장고 확인했는데 계란 없어"
"계란은 지금 0개야"
"계란 재고가 3개야"
"계란 다 써서 0개 남았어"

When ambiguous:
- If the sentence describes an action performed by the user, prefer consume_inventory.
- If the sentence describes an observed current state, prefer adjust_inventory.

Schema:
{
  "intent": "purchase_inventory" | "consume_inventory" | "adjust_inventory" | null,
  "items": [
    {
      "rawName": string,
      "quantity": number,
      "unit": string
    }
  ],
  "confidence": number,
  "requiresClarification": boolean,
  "unsupportedReason": 
    "unsupported_intent" |
    "unknown_product" |
    "ambiguous_quantity" |
    "insufficient_recorded_stock" optional
}

User input:
${prompt}
`;
  }
}
